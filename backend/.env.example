# Copy to .env (never commit the real file) and fill in what you need.
# Everything below is read by backend/v2/config.py. None of it is required
# to run the original v1 (Ollama-only) app in backend/main.py.

# --- LLM provider switch: "ollama" or "anthropic" --------------------------
LLM_PROVIDER=ollama

# --- Ollama (local, default) ------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# One of: qwen2.5:7b, llama3.1:8b
OLLAMA_MODEL=qwen2.5:7b

# --- Anthropic Claude (set LLM_PROVIDER=anthropic to use) -------------------
ANTHROPIC_API_KEY=
# One of: claude-opus-5, claude-sonnet-5, claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

LLM_TEMPERATURE=0.0

# --- SQL backend for the run_sql tool ---------------------------------------
# SQLite (default, zero config):
DATABASE_URL=sqlite:///./v2_data/databot.sqlite
# Or Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/databot

# --- LangSmith tracing -- off by default, opt in explicitly -----------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=databot-v2
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Agent behaviour ---------------------------------------------------------
AGENT_MAX_ITERATIONS=8
AGENT_MAX_ROWS=200
